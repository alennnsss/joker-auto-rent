PAYMENT_WEBHOOK_SECRET=

# Учётная запись администратора, которую создаёт `python -m app.seed`
ADMIN_EMAIL=admin@joker.kz
ADMIN_PASSWORD=admin12345

# Почта для кодов подтверждения email (пустой SMTP_HOST — код пишется в лог бэкенда)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
